<?xml version="1.0" encoding="utf-8"?>
<!-- VSTM Tune - macOS kurulum sihirbazi (productbuild). @VERSION@ build_pkg.sh tarafindan doldurulur. -->
<installer-gui-script minSpecVersion="2">
    <title>VSTM Tune @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in"
            description="VSTM Tune.vst3 -> /Library/Audio/Plug-Ins/VST3 (FL Studio, REAPER, Ableton Live, Cubase, Studio One ...)">
        <pkg-ref id="com.vstmaudio.vstmtune.pkg.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU) plug-in"
            description="VSTM Tune.component -> /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand)">
        <pkg-ref id="com.vstmaudio.vstmtune.pkg.au"/>
    </choice>
    <choice id="app" title="Standalone app"
            description="VSTM Tune.app -> /Applications (works without a DAW)">
        <pkg-ref id="com.vstmaudio.vstmtune.pkg.app"/>
    </choice>

    <pkg-ref id="com.vstmaudio.vstmtune.pkg.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.vstmaudio.vstmtune.pkg.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.vstmaudio.vstmtune.pkg.app" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
