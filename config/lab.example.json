{
  "juce_dir": "/path/to/JUCE",
  "plugin_path": "/path/to/YourPlugin.vst3",
  "pluginval_path": "pluginval",
  "sample_rates": [
    44100,
    48000,
    96000
  ],
  "block_sizes": [
    64,
    128,
    256,
    512,
    1024
  ],
  "default_sample_rate": 48000,
  "default_block_size": 512,
  "render_directory": "artifacts/audio-runs",
  "audio_perception": {
    "status": "local_model",
    "tool": "tools/ear.py",
    "setup": "tools/setup_ear.sh",
    "model": "Qwen2.5-Omni-7B Q4_K_M + mmproj Q8_0 (llama.cpp llama-mtmd-cli)",
    "home": "${VSTM_EAR_HOME:-~/.cache/vstm-ear}",
    "evidence_label": "LISTENED-MODEL",
    "calibration": "docs/vstm-audio-rd/EAR.md",
    "note": "AI model perception at 16 kHz mono. Not human listening; human packs via tools/audio_view.py pack."
  }
}
